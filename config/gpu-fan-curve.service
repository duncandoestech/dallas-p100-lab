[Unit]
Description=GPU temperature fan curve (ARCTIC USB fan controller)
After=nvidia-persistenced.service gpu-power-cap.service
Wants=nvidia-persistenced.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/gpu-fan-curve
ExecStart=/usr/bin/python3 /usr/local/bin/gpu-fan-curve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
